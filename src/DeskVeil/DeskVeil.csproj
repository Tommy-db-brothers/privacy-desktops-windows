<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The versioned TFM is still net8.0-windows; it adds the WinRT projections needed for Windows Hello. -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- VirtualDesktopAccessor.dll is x64 only. -->
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>DeskVeil</RootNamespace>
    <AssemblyName>DeskVeil</AssemblyName>
    <ApplicationIcon>DeskVeil.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Single-file publish: also bundle the loose native DLL; it is extracted next to the app at startup. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup>
    <LibDir>$(MSBuildThisFileDirectory)..\..\lib\</LibDir>
    <VdaReleaseTag>2024-12-16-windows11</VdaReleaseTag>
    <VdaDllPath>$(LibDir)VirtualDesktopAccessor.dll</VdaDllPath>
    <VdaSha256>8740C572A1C000E3B87FFEB1E4C397EAE9AF3BD4A2ABDC3BCFFACAB4493F8FF5</VdaSha256>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(VdaDllPath)" Link="VirtualDesktopAccessor.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(LibDir)VirtualDesktopAccessor.LICENSE.txt" Link="VirtualDesktopAccessor.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeskVeil.Tests" />
  </ItemGroup>

  <!--
    lib/VirtualDesktopAccessor.dll is committed. Should a checkout lack it, the pinned release is
    downloaded. Either way the build fails unless the file matches VdaSha256.
  -->
  <Target Name="FetchVirtualDesktopAccessor" BeforeTargets="BeforeBuild" Condition="!Exists('$(VdaDllPath)')">
    <Message Importance="high" Text="lib/VirtualDesktopAccessor.dll missing; downloading release $(VdaReleaseTag)." />
    <DownloadFile SourceUrl="https://github.com/Ciantic/VirtualDesktopAccessor/releases/download/$(VdaReleaseTag)/VirtualDesktopAccessor.dll"
                  DestinationFolder="$(LibDir)"
                  Retries="3"
                  RetryDelayMilliseconds="2000" />
  </Target>

  <Target Name="VerifyVirtualDesktopAccessor" BeforeTargets="BeforeBuild" DependsOnTargets="FetchVirtualDesktopAccessor">
    <GetFileHash Files="$(VdaDllPath)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="VdaActualSha256" />
    </GetFileHash>
    <Error Condition="'$(VdaActualSha256.ToUpperInvariant())' != '$(VdaSha256.ToUpperInvariant())'"
           Text="lib/VirtualDesktopAccessor.dll has SHA-256 $(VdaActualSha256), expected $(VdaSha256) (release $(VdaReleaseTag)). Restore the pinned file or update VdaReleaseTag and VdaSha256 together." />
  </Target>

</Project>
